<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup Condition="'$(BuildForTests)' == 'true'">
		<OutputPath>bin\Tests\$(Configuration)\</OutputPath>
		<IntermediateOutputPath>obj\Tests\$(Configuration)\</IntermediateOutputPath>
	</PropertyGroup>

  <Import Project="DriverVersion.props" />
	<PropertyGroup>
		<TargetFramework>net472</TargetFramework>
		<OutputType>Library</OutputType>
		<AssemblyName>TeslaPowerwallCrestronDriver</AssemblyName>
		<RootNamespace>TeslaPowerwall.CrestronDriver</RootNamespace>
		<LangVersion>latest</LangVersion>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);ILLink1005;CS1591</NoWarn>
		<Nullable>disable</Nullable>
		<IsPackable>true</IsPackable>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
		<PackageType>CrestronHomeDriver</PackageType>
		<PackageId>CrestronHomeDriver.Tesla.Powerwall</PackageId>
		<Authors>Neil Colvin</Authors>
		<Company>Neil Colvin</Company>
		<Description>Crestron Home Entity V2 Driver for Tesla Powerwall.</Description>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<RepositoryUrl>https://github.com/oznetmaster/TeslaPowerwallCrestronDriver</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<PackageProjectUrl>https://github.com/oznetmaster/TeslaPowerwallCrestronDriver</PackageProjectUrl>
		<PackageTags>crestron;crestron-home;driver;pkg;tesla;powerwall;smarthome</PackageTags>
		<PackageDriverPkgPath Condition="'$(PackageDriverPkgPath)' == ''"></PackageDriverPkgPath>
		<PackageDriverManifestPath Condition="'$(PackageDriverManifestPath)' == ''"></PackageDriverManifestPath>
		<TreatWarningsAsErrors Condition="'$(Configuration)' == 'Debug'">true</TreatWarningsAsErrors>
	</PropertyGroup>

	<!-- Lets the release workflow supply the GitHub Release notes as the NuGet package's release notes without
		  needing to escape multi-line text on the dotnet pack command line: it writes the notes to a plain text
		  file and passes that file's path in via PackageReleaseNotesFile, which is read here at pack time. -->
	<PropertyGroup Condition="'$(PackageReleaseNotesFile)' != '' And Exists('$(PackageReleaseNotesFile)')">
		<PackageReleaseNotes>$([System.IO.File]::ReadAllText('$(PackageReleaseNotesFile)'))</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="TeslaPowerwallLibrary" Version="2.0.0" />
		<PackageReference Include="Crestron.DeviceDrivers.DevKit" Version="27.0.24" />
		<PackageReference Include="Crestron.SimplSharp.SDK.Library" Version="2.22.15" />
		<PackageReference Include="Hafner.Compatibility.MetaPackage" Version="1.9.0" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="TeslaPowerwallCrestronDriver.json" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\README.md" Link="README.md" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\LICENSE" Link="LICENSE" Pack="true" PackagePath="\" Visible="false" />
		<None Include="$(PackageDriverPkgPath)" Pack="true" PackagePath="\" Visible="false" Condition="'$(PackageDriverPkgPath)' != ''" />
		<None Include="$(PackageDriverManifestPath)" Pack="true" PackagePath="\" Visible="false" Condition="'$(PackageDriverManifestPath)' != ''" />
		<None Include="IncludeInPkg\UiDefinitions\UiDefinition.xml" />
		<None Include="IncludeInPkg\Translations\en-US.json" />
		<None Include="BumpDriverVersion.ps1" />
		<None Include="Deploy.ps1" />
		<None Include="ILRepackMerge.ps1" />
		<None Include="PatchMergedAssembly.ps1" />
		<None Include="TeslaPowerwallCrestronDriver.csproj.user" />
		<None Include="TeslaPowerwallCrestronDriver.Local.targets" />
	</ItemGroup>

	<PropertyGroup>
		<LocalCrestronSdkLibDir Condition="'$(LocalCrestronSdkLibDir)' == ''">$(CRESTRON_DRIVER_SDK_LIBRARIES)</LocalCrestronSdkLibDir>
		<LocalNet472ReferenceAssemblies Condition="'$(LocalNet472ReferenceAssemblies)' == ''">$(NET472_REFERENCE_ASSEMBLIES)</LocalNet472ReferenceAssemblies>
		<LocalNetFxRuntimeDir Condition="'$(LocalNetFxRuntimeDir)' == ''">$(NETFX_RUNTIME_DIR)</LocalNetFxRuntimeDir>
		<ManifestUtilExe Condition="'$(ManifestUtilExe)' == ''">ManifestUtil.exe</ManifestUtilExe>
		<MergeDependenciesContinueOnError Condition="'$(MergeDependenciesContinueOnError)' == ''">false</MergeDependenciesContinueOnError>
		<PackageDriverContinueOnError Condition="'$(PackageDriverContinueOnError)' == ''">false</PackageDriverContinueOnError>
		<PackageDriverIgnoreExitCode Condition="'$(PackageDriverIgnoreExitCode)' == ''">false</PackageDriverIgnoreExitCode>
	</PropertyGroup>

	<Target Name="BumpDriverVersion" BeforeTargets="BeforeBuild" Condition="'$(BuildForTests)' != 'true' And '$(DesignTimeBuild)' != 'true'">
		<Exec Command="pwsh -NoProfile -NonInteractive -File &quot;$(MSBuildProjectDirectory)\BumpDriverVersion.ps1&quot; -ManifestPath &quot;$(MSBuildProjectDirectory)\TeslaPowerwallCrestronDriver.json&quot; -Configuration &quot;$(Configuration)&quot; -ReleaseVersion &quot;$(DriverReleaseVersion)&quot;" />
	</Target>

	<Target Name="MergeDependencies" AfterTargets="Build" Condition="'$(BuildForTests)' != 'true'">
        <PropertyGroup>
            <IlRepackToolDirectory Condition="'$(IlRepackToolDirectory)' == ''">$(UserProfile)\.dotnet\tools\.store\dotnet-ilrepack\2.0.45\dotnet-ilrepack\2.0.45\tools\net8.0\any</IlRepackToolDirectory>
            <MergedDriverPath>$(TargetDir)merged\$(AssemblyName).dll</MergedDriverPath>
        </PropertyGroup>
        <ItemGroup>
            <MergeInputs Include="$(TargetPath)" />
            <!-- Merge the complete resolved runtime closure; Crestron SDK assemblies are provided by the processor. -->
            <MergeInputs Include="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.dll' And !$([System.String]::Copy('%(ReferenceCopyLocalPaths.NuGetPackageId)').ToLowerInvariant().StartsWith('crestron.'))" />
        </ItemGroup>
        <WriteLinesToFile File="$(TargetDir)merge_inputs.txt" Lines="@(MergeInputs->'%(FullPath)')" Overwrite="true" />
        <Exec Command="pwsh -NoProfile -NonInteractive -File &quot;$(MSBuildProjectDirectory)\ILRepackMerge.ps1&quot; -TargetPath &quot;$(TargetPath)&quot; -OutputPath &quot;$(MergedDriverPath)&quot; -InputListFile &quot;$(TargetDir)merge_inputs.txt&quot; -LibDir &quot;$(TargetDir.TrimEnd('\'))&quot; -SdkLibDir &quot;$(LocalCrestronSdkLibDir)&quot; -FxRefDir &quot;$(LocalNet472ReferenceAssemblies)&quot; -FxRuntimeDir &quot;$(LocalNetFxRuntimeDir)&quot; -ToolDirectory &quot;$(IlRepackToolDirectory)&quot;" ContinueOnError="$(MergeDependenciesContinueOnError)" />
        <Exec Command="pwsh -NoProfile -NonInteractive -File &quot;$(MSBuildProjectDirectory)\PatchMergedAssembly.ps1&quot; -AssemblyPath &quot;$(MergedDriverPath)&quot; -OutputPath &quot;$(TargetDir)patched\$(AssemblyName).dll&quot; -CecilPath &quot;$(IlRepackToolDirectory)\Mono.Cecil.dll&quot; -InputListFile &quot;$(TargetDir)merge_inputs.txt&quot; -ManifestPath &quot;$(MSBuildProjectDirectory)\TeslaPowerwallCrestronDriver.json&quot;" ContinueOnError="false" />
	</Target>

	<Target Name="PackageDriver" AfterTargets="MergeDependencies" Condition="'$(BuildForTests)' != 'true'">
		<RemoveDir Directories="$(TargetDir)patched\IncludeInPkg" />
		<ItemGroup>
			<IncludeInPkgFiles Include="$(MSBuildProjectDirectory)\IncludeInPkg\**\*" Exclude="$(MSBuildProjectDirectory)\IncludeInPkg\**\*.xsd" />
		</ItemGroup>
		<Copy SourceFiles="@(IncludeInPkgFiles)" DestinationFiles="@(IncludeInPkgFiles->'$(TargetDir)patched\IncludeInPkg\%(RecursiveDir)%(Filename)%(Extension)')" />
		<Exec Command="&quot;$(ManifestUtilExe)&quot; --file &quot;$(TargetDir)patched\$(AssemblyName).dll&quot; --lib &quot;$(TargetDir.TrimEnd('\'))&quot; --output &quot;$(TargetDir.TrimEnd('\'))&quot;" ContinueOnError="$(PackageDriverContinueOnError)" IgnoreExitCode="$(PackageDriverIgnoreExitCode)" />
	</Target>

	<Target Name="DeployDriver" AfterTargets="PackageDriver" Condition="'$(BuildForTests)' != 'true' And '$(DeployAfterBuild)' == 'true' And '$(Configuration)' == 'Debug' And '$(CrestronHomeIP)' != ''">
		<PropertyGroup>
			<PkgFile>$(TargetDir)$(AssemblyName).pkg</PkgFile>
			<DeployScriptPath>$(MSBuildProjectDirectory)\Deploy.ps1</DeployScriptPath>
		</PropertyGroup>
		<Message Text="Deploying $(AssemblyName).pkg to $(CrestronHomeIP)..." Importance="High" />
		<Exec Command="pwsh -NoProfile -NonInteractive -File &quot;$(DeployScriptPath)&quot; -PkgFile &quot;$(PkgFile)&quot; -ProjectUserFile &quot;$(MSBuildProjectFullPath).user&quot;" />
	</Target>

	<Target Name="ValidateNuGetPkgInput" BeforeTargets="GenerateNuspec" Condition="'$(IsPacking)' == 'true'">
		<Error Condition="'$(PackageDriverPkgPath)' == ''" Text="PackageDriverPkgPath must be set when packing the NuGet package." />
		<Error Condition="!Exists('$(PackageDriverPkgPath)')" Text="PackageDriverPkgPath '$(PackageDriverPkgPath)' does not exist." />
		<Error Condition="'$(PackageDriverManifestPath)' == ''" Text="PackageDriverManifestPath must be set when packing the NuGet package." />
		<Error Condition="!Exists('$(PackageDriverManifestPath)')" Text="PackageDriverManifestPath '$(PackageDriverManifestPath)' does not exist." />
	</Target>

	<Import Project="TeslaPowerwallCrestronDriver.Local.targets" Condition="Exists('TeslaPowerwallCrestronDriver.Local.targets')" />

</Project>
